# Copy to .env and adjust as needed.

# SQLAlchemy database URL. Defaults to a local SQLite file.
# For Neon Postgres, use the connection string from the Neon console, e.g.:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=sqlite:///./vhn.db

# CORS origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Session cookie ---
# Secure flag: browsers only send the cookie back over HTTPS. Leave false for
# local http://localhost dev; set true in production (Railway serves over HTTPS).
COOKIE_SECURE=false

# --- Web Push (VAPID) ---
# Leave blank locally: a keypair is auto-generated and cached to disk on first run
# (and the values to promote are printed to the console). In PRODUCTION set BOTH,
# or every redeploy generates a new pair and existing push subscriptions break.
# Private key is a PKCS8 PEM; write its newlines as literal \n on one line.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- OpenBioLLM ---
# Backend: "" (rule-based stub), "hf_api" (hosted on HF, no download),
#          "transformers" (local, needs a big GPU), or "llamacpp" (local GGUF).
LLM_BACKEND=
# Hugging Face model id (used by hf_api and transformers).
LLM_MODEL_ID=aaditya/Llama3-OpenBioLLM-8B
# Token for the hosted Inference API (hf_api). Free: https://huggingface.co/settings/tokens
HF_TOKEN=
# Path to a local GGUF quant for the llamacpp backend (leave empty otherwise).
LLM_MODEL_PATH=
